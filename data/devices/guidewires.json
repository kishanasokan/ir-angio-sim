  "behaviorRules": [
    {"text": "Stainless cores give good torque, push and support but bend permanently; nitinol cores are kink resistant and re-shapeable with less torque and push.", "confidence": "sourced", "source": "eurointervention-guidewires"},
    {
      "text": "Core-to-tip designs steer better but perforate more; shaping-ribbon tips are gentler with less torque; tapered tips penetrate far more than untapered tips of equal tip load.",
      "confidence": "sourced",
      "source": "eurointervention-guidewires"
