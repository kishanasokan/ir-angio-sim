  "rules": [
    {"id": "cath-over-wire", "text": "Catheters are advanced in the vessel only over a wire.", "confidence": "sourced", "source": "radiologykey-tools"},
    {"id": "cath-diagnostic-size", "text": "Most diagnostic angiography uses 4 or 5F catheters over 0.035 or 0.038 in wires.", "confidence": "sourced", "source": "dir-catheters-2023"},
    {"id": "cath-torque", "text": "Torsional strength scales with outer diameter to the fourth minus inner diameter to the fourth; wire braid raises rotational stability about 3-fold.", "confidence": "sourced", "source": "dir-catheters-2023"},
    {"id": "cath-flow", "text": "Flow follows Poiseuille: doubling the inner diameter gives 16 times the flow; longer catheters flow less.", "confidence": "sourced", "source": "dir-catheters-2023"},
    {"id": "cath-jet", "text": "A high-pressure jet from an end hole against the wall can inject subintimally; side holes reduce recoil.", "confidence": "sourced", "source": "dir-catheters-2023"},
    {"id": "cath-steam-shape", "text": "Catheter curves can be reshaped by steam heating, bending and quenching in cold sterile saline.", "confidence": "sourced", "source": "dir-catheters-2023"},
    {"id": "cath-chuang-110", "text": "Chuang 110 rule: tip length past the primary curve and curve width about 110% of the native artery.", "confidence": "sourced", "source": "dir-catheters-2023"}
  ]
