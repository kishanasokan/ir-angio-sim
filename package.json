{
  "name": "ir-angio-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Free, browser-based, controller-first interventional radiology angio suite simulator. Educational simulation only.",
  "license": "MIT",
  "author": "Kishan Asokan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kishanasokan/ir-angio-sim.git"
  },
  "bugs": {
    "url": "https://github.com/kishanasokan/ir-angio-sim/issues"
  },
  "homepage": "https://github.com/kishanasokan/ir-angio-sim#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-data && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate-data": "tsx scripts/validate-data.ts",
    "bench": "tsx scripts/bench.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
